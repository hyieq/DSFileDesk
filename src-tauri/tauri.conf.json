{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileDesk",
  "version": "0.4.1",
  "identifier": "com.filedesk.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FileDesk",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "dragDropEnabled": true,
        "transparent": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "resources": {
      "decoder/": "decoder/",
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "wix": {
        "language": "zh-CN",
        "upgradeCode": "69c27fb3-e560-5efd-aa3b-81e058bac852"
      }
    },
    "useLocalToolsDir": true
  }
}
